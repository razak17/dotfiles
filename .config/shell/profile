#!/bin/zsh

typeset -U PATH path

# ssh
# eval "$(ssh-agent -s)"
# ssh-add ~/.ssh/id_rsa_razak17

LOCAL="$HOME/.local/bin"
path+=(
  "$LOCAL"
  "$LOCAL/dmenu"
  "$LOCAL/dwm"
  "$LOCAL/sb"
  "$LOCAL/statusbar"
  "$LOCAL/startup"
  "$LOCAL/utils"
)

# java
export JAVA_HOME="/usr/lib/jvm/java-26-openjdk";

# Go user binaries
export GOPATH="$HOME/go"
path+=(
  "$GOPATH/bin"
)

# Fly
if [ -e "$HOME/.fly/bin/fly" ]; then
  export FLYCTL_INSTALL="$HOME/.fly"
  path+=(
  "$FLYCTL_INSTALL/bin"
  )
fi

# Turso
if [ -e "$HOME/.turso/turso" ]; then
  export TURSO_INSTALL="$HOME/.turso/"
  path+=(
  "$TURSO_INSTALL"
  )
fi

# Cargo user binaries
if [ -e "$HOME/.cargo" ]; then
  path+=(
  "$HOME/.cargo/bin"
  )
fi

export PATH
