#!/bin/zsh

# ZSH only and most performant way to check existence of an executable
# https://www.topbug.net/blog/2016/10/11/speed-test-check-the-existence-of-a-command-in-bash-and-zsh/
exists() { (( $+commands[$1] )); }

# Run a command with elevated privileges. Prefer doas, but keep these
# dotfiles usable on systems where only sudo is installed.
as_root() {
  if exists doas; then
    command doas "$@"
  elif exists sudo; then
    command sudo "$@"
  else
    print -u2 "as_root: install doas or sudo"
    return 127
  fi
}

# Default to using `bat` https://github.com/sharkdp/bat#installation if it has been installed
cat() {
  if hash bat 2>/dev/null; then
    bat "$@"
  else
    command cat "$@"
  fi
}

# chmod a directory
ch() {
  if (( $# < 2 )); then
    print -u2 "Usage: ch MODE PATH..."
    return 2
  fi

  local mode="$1"
  shift
  as_root chmod -R -- "$mode" "$@"
}

# chmod executable
cx() {
  chmod +x -- "$@"
}

rcs() {
  as_root rc-service "$1" "$2"
}

rcadd() {
  as_root rc-update add "$1" default
}

rcdel() {
  as_root rc-update del "$1" default
}

zshcomp() {
  for command completion in "${(@kv)_comps}"; do
    [[ $command == -* ]] && continue
    printf "%-32s %s\n" "$command" "$completion"
  done | sort
}

pacov() {
  as_root pacman -S "$@" --overwrite '*'
}

scrdim() {
  xdpyinfo | awk '/dimensions/{print $2}'
}

ivpn() {
  if (( $# != 1 )); then
    echo "Usage: vpn FILE.ovpn" >&2
    return 2
  fi

  as_root openvpn \
    --config "$1" \
    --auth-user-pass "$HOME/docs/STUFF/vpn.txt"
}

mc() {
  mkdir -p "$@" && cd "$@"
}

scr() {
	pushd "$HOME/Pictures/screenshots" >/dev/null || return
	if exists yazi; then
		yazi
	fi
	cd - || return
}

usb1() {
  if [ ! -d "/mnt/usb1/TV" ]; then
    as_root mkdir -p /mnt/usb1 || return
    as_root mount /dev/sda1 /mnt/usb1 || return
  fi
  cd /mnt/usb1/
}

function gL() {
  if command -v git-graph &>/dev/null; then
    git-graph -s round
  else
    git log --oneline --graph --decorate --all
  fi
}

buildnvim() {
  local neovim_dir="$HOME/.dots/neovim"
  local bin_dir="$HOME/.local/bin"
  local oldfile

  if [[ ! -d "$neovim_dir" ]]; then
    git clone https://github.com/neovim/neovim "$neovim_dir" || return
  fi

  pushd "$neovim_dir" >/dev/null || return
  git checkout master || { popd >/dev/null; return 1; }
  # git pull upstream master
  git pull || { popd >/dev/null; return 1; }

  if [[ -d "$neovim_dir/build" ]]; then
    if [[ -w "$neovim_dir/build" ]]; then
      rm -rf -- "$neovim_dir/build"
    else
      # Clean up build files created by older versions of this function.
      as_root rm -rf -- "$neovim_dir/build" || { popd >/dev/null; return 1; }
    fi
  fi

  make CMAKE_BUILD_TYPE=Release \
    CMAKE_EXTRA_FLAGS="-DCMAKE_INSTALL_PREFIX=$HOME/neovim" || {
      popd >/dev/null
      return 1
    }
  make install || { popd >/dev/null; return 1; }

  # Save old binary
  oldfile="nvim-$(date +%F_%H%M%S_%N)"
  print -r -- "$oldfile"
  mkdir -p "$bin_dir" || { popd >/dev/null; return 1; }
  [[ -e "$bin_dir/nvim" ]] && mv -- "$bin_dir/nvim" "$bin_dir/$oldfile"
  cp -- "$HOME/neovim/bin/nvim" "$bin_dir/" || {
    popd >/dev/null
    return 1
  }

  popd >/dev/null
}

function venv() {
  if [ -z "$1" ]; then
    echo "Usage: venv <name>"
    return
  fi

  if ! [ -d "$1" ]; then
    python3 -m venv "$1"
  fi

  source "$1/bin/activate"
}

zen_installer() {
  # stable  / twilight
  bash <(curl https://updates.zen-browser.app/appimage.sh) "$1"

  if [[ "$1" == "twilight" ]]; then
    [ -e "$HOME/.local/bin/zen-tw" ] && rm "$HOME/.local/bin/zen-tw"
    ln -s "$HOME/.local/share/AppImage/ZenTwilight.AppImage" "$HOME/.local/bin/zen-tw"
    return
  fi

  if [ -e "$HOME/.local/share/AppImage/ZenBrowser.AppImage" ] ; then
    [ -e "$HOME/.local/bin/zen" ] && rm "$HOME/.local/bin/zen"
    ln -s  "$HOME/.local/share/AppImage/ZenBrowser.AppImage" "$HOME/.local/bin/zen"
  fi
}

zen_del() {
  pushd "$HOME/.zen" || return

  if ls -d firefox-* 1>/dev/null 2>&1; then
    rm -r firefox-*
  fi

  cd -
}

zen_update() {
}

zip_ext() {
  name=$1
  pushd "./dist"
  zip -1 -r $name * && mv $name ..
  cd -
}

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

copilot_models() {
  dd=$(date +%F_%H%M%S_%N)
  token=$1
  curl -L -H "Authorization: Bearer $token" -H "Copilot-Integration-Id: vscode-chat" -H "Editor-Plugin-Version: CopilotChat.nvim/*" -H "Editor-Version: Neovim/0.11.0" https://api.individual.githubcopilot.com/models -o "/tmp/models-$dd.json"
  if [ -e "/tmp/models-$dd.json" ]; then
    $TEXT_EDITOR "/tmp/models-$dd.json"
  fi
}

upgrade_pg() {
  if (( $# != 2 )) || [[ "$1" != <-> || "$2" != <-> ]] || (( $1 <= $2 )); then
    print -u2 "Usage: upgrade_pg NEW_VERSION OLD_VERSION"
    return 2
  fi

  local new="$1" # Just the number eg. 18
  local old="$2" # Just the number eg. 17
  local current_version="/var/lib/postgres/data"
  local new_version="/var/lib/postgres/data-$new"
  local backup_version="/var/lib/postgres/data-$old-backup"
  local old_bin="/opt/pgsql-$old/bin"
  local cluster_version

  if [[ ! -d "$current_version" ]]; then
    print -u2 "upgrade_pg: current data directory not found: $current_version"
    return 1
  fi
  if [[ ! -r "$current_version/PG_VERSION" ]]; then
    print -u2 "upgrade_pg: cannot read $current_version/PG_VERSION"
    return 1
  fi
  cluster_version="$(<"$current_version/PG_VERSION")"
  if [[ "$cluster_version" != "$old" ]]; then
    print -u2 "upgrade_pg: data directory is version $cluster_version, not $old"
    return 1
  fi
  if [[ -e "$new_version" || -e "$backup_version" ]]; then
    print -u2 "upgrade_pg: target or backup directory already exists"
    return 1
  fi
  # 1. Install the old PostgreSQL binaries (needed for pg_upgrade)
  as_root pacman -S --noconfirm postgresql-old-upgrade || return
  if [[ ! -d "$old_bin" ]]; then
    print -u2 "upgrade_pg: old PostgreSQL binaries not found after installation: $old_bin"
    return 1
  fi

  # 2. Create a new data directory for the new PostgreSQL version
  as_root mkdir -p "$new_version" || return
  as_root chown postgres:postgres "$new_version" || return

  # 3. Initialize the new data directory
  as_root -u postgres initdb -D "$new_version" || return

  # 4. Run pg_upgrade
  as_root -u postgres pg_upgrade \
    --old-datadir="$current_version" \
    --new-datadir="$new_version" \
    --old-bindir="$old_bin" \
    --new-bindir=/usr/bin || return

  # 5. If successful, swap directories
  as_root mv -- "$current_version" "$backup_version" || return
  if ! as_root mv -- "$new_version" "$current_version"; then
    print -u2 "upgrade_pg: swap failed; restoring the original data directory"
    as_root mv -- "$backup_version" "$current_version"
    return 1
  fi

  # 6. Start PostgreSQL
  as_root rc-service postgresql start

  # NOTE: The data directory was initialized by PostgreSQL version issue
  # https://wiki.archlinux.org/title/PostgreSQL#Upgrading_PostgreSQL

  # sudo pacman -Syu postgresql postgresql-libs postgresql-old-upgrade

  # mv /var/lib/postgres/data /var/lib/postgres/olddata
  # mkdir /var/lib/postgres/data /var/lib/postgres/tmp
  # chown postgres:postgres /var/lib/postgres/data /var/lib/postgres/tmp

  # sudo -iu postgres
  # initdb --locale=en_US.UTF-8 -E UTF8 -D /var/lib/postgres/data

  # pg_upgrade -b /opt/pgsql-<PG_VERSION>/bin -B /usr/bin -d /var/lib/postgres/olddata -D /var/lib/postgres/data
}
