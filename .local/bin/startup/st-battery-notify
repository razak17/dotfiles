#!/bin/sh

power_supply_root=${POWER_SUPPLY_ROOT:-/sys/class/power_supply}
battery=

for candidate in "$power_supply_root"/BAT?*; do
	[ -d "$candidate" ] || continue
	battery=$candidate
	break
done

[ -n "$battery" ] || exit 0

send_notification() {
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send "$@" || :
}

while :; do
	if ! IFS= read -r battery_level <"$battery/capacity" 2>/dev/null; then
		sleep 60
		continue
	fi

	case $battery_level in
	'' | *[!0-9]*)
		sleep 60
		continue
		;;
	esac

	if ! IFS= read -r battery_status <"$battery/status" 2>/dev/null; then
		battery_status=Unknown
	fi

	case $battery_status in
	Charging | Full)
		if [ "$battery_level" -ge 100 ]; then
			send_notification \
				-u normal \
				"You may want to disconnect your charger" \
				"Battery is fully charged" \
				-i battery-full \
				-t 2000
		fi
		;;
	*)
		if [ "$battery_level" -lt 20 ]; then
			send_notification \
				-u critical \
				"You may want to connect your charger" \
				"Battery level is ${battery_level}%" \
				-i battery-low \
				-t 2000
		fi
		;;
	esac

	if [ "$battery_level" -lt 15 ]; then
		sleep 50
	elif [ "$battery_level" -lt 20 ]; then
		sleep 150
	elif [ "$battery_level" -lt 25 ]; then
		sleep 300
	else
		sleep 250
	fi
done
