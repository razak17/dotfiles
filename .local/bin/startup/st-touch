#!/bin/sh

command -v xinput >/dev/null 2>&1 || exit 0

touch_id=$(
    xinput list --short 2>/dev/null |
        awk 'tolower($0) ~ /touchpad/ {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^id=[0-9]+$/) {
                    sub(/^id=/, "", $i)
                    print $i
                    exit
                }
            }
        }'
)

[ -n "$touch_id" ] || exit 0

set_property_if_available() {
    property=$1
    value=$2

    if xinput list-props "$touch_id" 2>/dev/null | grep -Fq "$property ("; then
        xinput set-prop "$touch_id" "$property" "$value"
    fi
}

set_property_if_available "libinput Tapping Enabled" 1
set_property_if_available "libinput Accel Speed" 0.7
