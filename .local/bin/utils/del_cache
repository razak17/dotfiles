#!/bin/bash

brave=~/.cache/BraveSoftware/Brave-Browser/Default/Cache
conda=~/miniconda3/pkgs/cache
moz=~/.cache/mozilla/firefox/profiles/default/cache2
pip=~/.cache/pip
yarn=~/.cache/yarn
yay=~/.cache/yay
pkg=/var/cache/pacman/pkg/
npm=~/.npm/_cacache/content-v2/sha512/
paru=~/.cache/paru/clone

## npm cache clean --force

deleteDir() {
	needs_root=$1
	shift

	for dir in "$@"; do
		if [[ -d $dir ]]; then
			if [[ $needs_root == root ]]; then
				as-root rm -rf -- "$dir" || return 1
			else
				rm -rf -- "$dir" || return 1
			fi
			echo "${dir} has been removed."
		else
			echo "${dir} does not exist."
		fi
	done
}

while [[ "$#" -gt 0 ]]; do
	curr=$1
	shift

	case "$curr" in
	"-h")
		echo "help"
		;;
	"-a")
		deleteDir user "$brave"/*
		deleteDir user "$conda"/*
		deleteDir user "$moz"/*
		deleteDir user "$pip"/*
		deleteDir user "$yarn"/*
		deleteDir user "$yay"/*
		deleteDir root "$pkg"/*
		deleteDir user "$npm"/*
		deleteDir user "$paru"/*
		;;
	"-b")
		deleteDir user "$brave"/*
		;;
	"-c")
		deleteDir user "$conda"/*
		;;
	"-m")
		deleteDir user "$moz"/*
		;;
	"-y")
		deleteDir user "$yarn"/*
		;;
	*) echo "Unavailable command... $curr" ;;
	esac
done
